  {
   "id": "L1",
   "beat": "b1",
   "text": "Earth's magnetic field is already weakening.",
   "start": 0.04,
   "end": 2.06
  },
  {
   "id": "L2",
   "beat": "b2",
   "text": "Its main dipole has faded about 6.3% per century.",
   "start": 2.406,
   "end": 6.306
  },
  {
   "id": "L3",
   "beat": "b3",
   "text": "Fields have flipped 183 times in 83 million years.",
   "start": 6.668,
   "end": 10.928
  },
  {
   "id": "L4",
   "beat": "b4",
   "text": "The last flip was 780,000 years ago.",
   "start": 11.234,
   "end": 14.284
  },
  {
   "id": "L5",
   "beat": "b5",
   "text": "Now switch it off completely, for just one day.",
   "start": 14.624,
   "end": 17.154
  },
  {
   "id": "L6",
   "beat": "b6",
   "text": "Satellites and power grids would take more charged particles.",
   "start": 17.532,
   "end": 20.772
  },
  {
   "id": "L7",
   "beat": "b7",
   "text": "But the air wouldn't vanish in a day; that takes far longer.",
   "start": 21.093,
   "end": 24.153
  },
  {
   "id": "L8",
   "beat": "b8",
   "text": "So we'd survive, but our technology would feel it first.",
   "start": 24.524,
   "end": 27.544
  }
 ],
