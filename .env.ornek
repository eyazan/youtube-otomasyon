# Bu dosyayi .env olarak kopyalayip kendi anahtarlarinizi yazin.
# Panel > Kaynaklar sekmesinden de girebilirsiniz.

# Senaryo motoru — app.vidiq.com/account/settings/mcp
VIDIQ_KEY=

# Gorsel kaynaklari (istege bagli, hicbiri zorunlu degil)
PEXELS_KEY=
PIXABAY_KEY=
UNSPLASH_KEY=

# --- GORSEL URETIMI (hepsi istege bagli) ---
# Hicbiri yoksa Pollinations kullanilir; o anahtar istemiyor.
CF_ACCOUNT_ID=
CF_API_TOKEN=
TOGETHER_KEY=
HF_TOKEN=

# --- YOUTUBE YUKLEME (istege bagli; yoksa yukleme yapilmaz) ---
# Kurulum ve maliyetler: MALIYET-VE-YETKILER.md
# Jetonu almak icin: node youtube-yetki.js
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Yukleme gizliligi: private (varsayilan) | unlisted | public
YT_PRIVACY=private
# Kategori (27=Egitim). Liste: YouTube Data API videoCategories.
YT_CATEGORY_ID=27
