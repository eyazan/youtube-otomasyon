 "lines": [
  {
   "id": "L1",
   "beat": "b1",
   "text": "This free kick was flying wide. Then it turned.",
   "start": 0.03,
   "end": 3.12
  },
  {
   "id": "L2",
   "beat": "b2",
   "text": "Lyon, June 1997. Brazil against France.",
   "start": 3.504,
   "end": 7.744
  },
  {
   "id": "L3",
   "beat": "b3",
   "text": "Roberto Carlos hit it with the outside of his left foot, from far out.",
   "start": 8.077,
   "end": 12.617
  },
  {
   "id": "L4",
   "beat": "b4",
   "text": "The ball swung around the wall and kept heading wide.",
   "start": 12.981,
   "end": 16.201
  },
  {
   "id": "L5",
   "beat": "b5",
   "text": "Then it bent back in, past a goalkeeper who never moved.",
   "start": 16.551,
   "end": 19.951
  },
  {
   "id": "L6",
   "beat": "b6",
   "text": "In 2010, French physicists showed why.",
   "start": 20.283,
   "end": 23.223
  },
  {
   "id": "L7",
   "beat": "b7",
   "text": "Spin pushes the ball sideways. Drag slows the ball down, but the spin keeps going.",
   "start": 23.576,
   "end": 29.256
  },
  {
   "id": "L8",
   "beat": "b8",
   "text": "So the slower it flies, the tighter it curves, into a spiral.",
   "start": 29.611,
   "end": 33.581
  },
  {
   "id": "L9",
   "beat": "b9",
   "text": "That is why the bend came so late. Every goal has a story.",
   "start": 34.089,
   "end": 37.949
  }
 ],
