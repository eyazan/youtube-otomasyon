 "cues": [
  {
   "start": 0.03,
   "end": 1.752,
   "lines": [
    "This free kick",
    "was flying wide."
   ]
  },
  {
   "start": 1.752,
   "end": 3.504,
   "lines": [
    "Then it turned."
   ]
  },
  {
   "start": 3.504,
   "end": 6.124,
   "lines": [
    "Lyon, June 1997."
   ]
  },
  {
   "start": 6.124,
   "end": 8.077,
   "lines": [
    "Brazil against France."
   ]
  },
  {
   "start": 8.077,
   "end": 10.337,
   "lines": [
    "Roberto Carlos",
    "hit it with the"
   ]
  },
  {
   "start": 10.337,
   "end": 11.965,
   "lines": [
    "outside of",
    "his left foot,"
   ]
  },
  {
   "start": 11.965,
   "end": 12.981,
   "lines": [
    "from far out."
   ]
  },
  {
   "start": 12.981,
   "end": 14.901,
   "lines": [
    "The ball swung",
    "around the wall"
   ]
  },
  {
   "start": 14.901,
   "end": 16.551,
   "lines": [
    "and kept heading wide."
   ]
  },
  {
   "start": 16.551,
   "end": 18.001,
   "lines": [
    "Then it bent back in,"
   ]
  },
  {
   "start": 18.001,
   "end": 20.283,
   "lines": [
    "past a goalkeeper",
    "who never moved."
   ]
  },
  {
   "start": 20.283,
   "end": 21.443,
   "lines": [
    "In 2010,"
   ]
  },
  {
   "start": 21.443,
   "end": 23.576,
   "lines": [
    "French physicists",
    "showed why."
   ]
  },
  {
   "start": 23.576,
   "end": 25.945999999999998,
   "lines": [
    "Spin pushes the",
    "ball sideways."
   ]
  },
  {
   "start": 25.966,
   "end": 27.856,
   "lines": [
    "Drag slows",
    "the ball down,"
   ]
  },
  {
   "start": 27.856,
   "end": 29.611,
   "lines": [
    "but the spin",
    "keeps going."
   ]
  },
  {
   "start": 29.611,
   "end": 31.301,
   "lines": [
    "So the slower it flies,"
   ]
  },
  {
   "start": 31.301,
   "end": 32.591,
   "lines": [
    "the tighter it curves,"
   ]
  },
  {
   "start": 32.591,
   "end": 33.981,
   "lines": [
    "into a spiral."
   ]
  },
  {
   "start": 34.089,
   "end": 35.619,
   "lines": [
    "That is why",
    "the bend came"
   ]
  },
  {
   "start": 35.619,
