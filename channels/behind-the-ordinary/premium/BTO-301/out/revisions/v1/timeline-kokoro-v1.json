 "lines": [
  {
   "id": "L1",
   "beat": "b1",
   "text": "Those three QR squares aren't decoration.",
   "start": 0.05,
   "end": 2.24
  },
  {
   "id": "L2",
   "beat": "b2",
   "text": "They tell the scanner where to look.",
   "start": 2.607,
   "end": 4.027
  },
  {
   "id": "L3",
   "beat": "b3",
   "text": "Denso Wave released the QR Code in 1994, and QR means quick response.",
   "start": 4.579,
   "end": 9.779
  },
  {
   "id": "L4",
   "beat": "b4",
   "text": "The corner marks are position detection patterns. Finding them made high-speed reading possible.",
   "start": 10.08,
   "end": 15.48
  },
  {
   "id": "L5",
   "beat": "b5",
   "text": "Why squares? The team said that pattern was least likely to appear on business forms.",
   "start": 15.805,
   "end": 20.325
  },
  {
   "id": "L6",
   "beat": "b6",
   "text": "They surveyed flyers, magazines and cardboard boxes for the rarest black-and-white ratio.",
   "start": 20.646,
   "end": 26.256
  },
  {
   "id": "L7",
   "beat": "b7",
   "text": "That rare ratio lets a scanner orient the code from any angle.",
   "start": 26.745,
   "end": 30.315
  }
 ],
