 "lines": [
  {
   "id": "L1",
   "beat": "b1",
   "text": "The first shopping cart barely looked like a cart.",
   "start": 0.04,
   "end": 2.54
  },
  {
   "id": "L2",
   "beat": "b2",
   "text": "And shoppers first refused to push it.",
   "start": 2.885,
   "end": 4.715
  },
  {
   "id": "L3",
   "beat": "b3",
   "text": "In 1936, grocer Sylvan Goldman wondered how customers could move more groceries.",
   "start": 5.305,
   "end": 11.005
  },
  {
   "id": "L4",
   "beat": "b4",
   "text": "He put a basket on a folding chair's seat and wheels on its legs.",
   "start": 11.337,
   "end": 14.877
  },
  {
   "id": "L5",
   "beat": "b5",
   "text": "His Humpty Dumpty stores introduced these folding basket carriers in 1937.",
   "start": 15.207,
   "end": 20.607
  },
  {
   "id": "L6",
   "beat": "b6",
   "text": "One offended woman told him she had pushed her last baby.",
   "start": 20.933,
   "end": 24.113
  },
  {
   "id": "L7",
   "beat": "b7",
   "text": "So Goldman hired models to push the carts around his store.",
   "start": 24.451,
   "end": 27.591
  },
  {
   "id": "L8",
   "beat": "b8",
   "text": "After that, the folding chair on wheels became extremely popular.",
   "start": 28.118,
   "end": 31.618
  }
 ],
