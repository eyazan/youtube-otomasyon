  {
   "id": "L1",
   "beat": "b1",
   "text": "Humanity's deepest hole stopped at 12,262 metres.",
   "start": 0.06,
   "end": 4.56
  },
  {
   "id": "L2",
   "beat": "b2",
   "text": "It barely scratched the crust.",
   "start": 4.872,
   "end": 6.102
  },
  {
   "id": "L3",
   "beat": "b3",
   "text": "Soviet engineers began drilling Kola SG-3 in 1970.",
   "start": 6.48,
   "end": 10.86
  },
  {
   "id": "L4",
   "beat": "b4",
   "text": "They aimed for 15,000 metres and fell short.",
   "start": 11.234,
   "end": 13.954
  },
  {
   "id": "L5",
   "beat": "b5",
   "text": "Heat stopped them: 180 °C, far above what they expected.",
   "start": 14.398,
   "end": 18.628
  },
  {
   "id": "L6",
   "beat": "b6",
   "text": "Rock that hot starts behaving more like plastic than stone.",
   "start": 19.017,
   "end": 22.317
  },
  {
   "id": "L7",
   "beat": "b7",
   "text": "Deeper down, the heat and pressure only climb.",
   "start": 22.651,
   "end": 24.921
  },
  {
   "id": "L8",
   "beat": "b8",
   "text": "So the planet's first defence against drilling is heat, not hardness.",
   "start": 25.283,
   "end": 28.913
  }
 ],
