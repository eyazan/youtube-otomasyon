 "cues": [
  {
   "start": 0.06,
   "end": 1.948,
   "lines": [
    "Less than a second",
    "after liftoff,"
   ]
  },
  {
   "start": 1.948,
   "end": 3.9160000000000004,
   "lines": [
    "Challenger was",
    "already leaking."
   ]
  },
  {
   "start": 4.046,
   "end": 5.578,
   "lines": [
    "Smoke was puffing",
    "from a joint"
   ]
  },
  {
   "start": 5.578,
   "end": 6.816,
   "lines": [
    "on the right booster,"
   ]
  },
  {
   "start": 6.816,
   "end": 9.156,
   "lines": [
    "sealed by two",
    "rubber O-rings."
   ]
  },
  {
   "start": 9.156,
   "end": 11.203,
   "lines": [
    "That morning was",
    "fifteen degrees colder"
   ]
  },
  {
   "start": 11.203,
   "end": 12.833,
   "lines": [
    "than any launch before."
   ]
  },
  {
   "start": 12.833,
   "end": 15.026,
   "lines": [
    "And cold rubber",
    "springs back slowly."
   ]
  },
  {
   "start": 15.026,
   "end": 16.485,
   "lines": [
    "So when ignition",
    "flexed the joint"
   ]
  },
  {
   "start": 16.485,
   "end": 18.825,
   "lines": [
    "open, the O-rings",
    "couldn't keep up,"
   ]
  },
  {
   "start": 18.825,
   "end": 20.725,
   "lines": [
    "and hot gas",
    "blew past them."
   ]
  },
  {
   "start": 20.725,
   "end": 21.975,
   "lines": [
    "Then the smoke stopped,"
   ]
  },
  {
   "start": 21.975,
   "end": 23.503,
   "lines": [
    "and Challenger flew on."
   ]
  },
  {
   "start": 23.519,
   "end": 24.99,
   "lines": [
    "Fifty-eight seconds in,"
   ]
  },
  {
   "start": 24.99,
   "end": 26.73,
   "lines": [
    "a flame broke",
    "through and swept"
   ]
  },
  {
   "start": 26.73,
   "end": 28.773,
   "lines": [
    "onto the external",
    "fuel tank."
   ]
  },
  {
   "start": 29.043,
   "end": 30.637,
   "lines": [
    "At seventy-three",
    "seconds,"
   ]
  },
  {
   "start": 30.637,
   "end": 31.798,
   "lines": [
    "the tank failed,"
   ]
  },
  {
   "start": 31.798,
   "end": 33.46,
   "lines": [
    "and Challenger",
    "broke apart."
   ]
  },
  {
   "start": 33.89,
   "end": 36.297000000000004,
   "lines": [
    "All seven crew",
    "members were lost."
   ]
  },
  {
   "start": 36.776,
   "end": 37.928,
   "lines": [
    "The night before,"
   ]
  },
  {
   "start": 37.928,
   "end": 40.354,
   "lines": [
    "engineers had recommended",
    "not launching below"
   ]
  },
  {
   "start": 40.354,
   "end": 41.874,
   "lines": [
    "fifty-three degrees."
   ]
  },
  {
   "start": 41.874,
   "end": 43.761,
   "lines": [
    "Their managers",
    "reversed that advice,"
   ]
  },
  {
   "start": 43.761,
   "end": 45.661,
   "lines": [
    "and NASA's top launch",
    "officials never"
   ]
  },
  {
   "start": 45.661,
   "end": 46.503,
   "lines": [
    "heard it."
   ]
  }
 ]
